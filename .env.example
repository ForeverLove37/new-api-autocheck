# Change these before exposing the application on the internet.
AUTOCHECK_ADMIN_PASSWORD=replace-with-a-long-unique-password
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTOCHECK_ENCRYPTION_KEY=
AUTOCHECK_AUTH_REQUIRED=true
AUTOCHECK_DATABASE_PATH=/opt/checker/data/autocheck.db

# Defaults used when importing the legacy text files for the first time.
AUTOCHECK_LEGACY_ACCOUNT_FILE=/opt/checker/account.txt
AUTOCHECK_LEGACY_PROXY_FILE=/opt/checker/proxy.txt
